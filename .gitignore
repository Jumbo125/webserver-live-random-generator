# Lokale/geheime Konfiguration (Vorlagen *.example.php bleiben versioniert)
/config.php
/config.turnstile.php

# Enthält echte Adresse/Name (Vorlage impressum.example.php bleibt versioniert)
/impressum.php

# Referenzdatei aus der Projekterstellung, nicht Teil der eigentlichen App
/matrix_zahlen_live.html

# Laufzeitdaten: JSON-Sitzungen, Lockdateien, Rate-Limit-Zähler
/private/live-draw/*
!/private/live-draw/.htaccess

# Lokal gebündelte Drittanbieter-Bibliotheken (nicht Teil des eigenen Codes).
